{
  "name": "codex-deepseek-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Delegate coding tasks from Codex to DeepSeek Harness via MCP, without changing Codex model.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/launcher.mjs open",
    "mcp": "node src/mcp-server.mjs",
    "stop": "node src/launcher.mjs stop",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "check:syntax": "node scripts/check.mjs --syntax-only",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:agent": "node scripts/live-agent-smoke.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.3.6"
  }
}
